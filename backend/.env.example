# ---------------- LOCAL DEVELOPMENT ----------------
NODE_ENV=development
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://couplevault:couplevault@localhost:5432/couplevault
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-a-random-64-character-secret
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=security@yourdomain.com
OTP_EXPIRES_MINUTES=10
MAX_UPLOAD_MB=50

# ---------------- PRODUCTION ----------------
# Set these in your cloud secret manager, not in git.
# NODE_ENV=production
# FRONTEND_ORIGIN=https://app.yourdomain.com
# DATABASE_URL=postgresql://...
# REDIS_URL=rediss://...
# SESSION_SECRET=...
# STORAGE_PROVIDER=s3
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=usvault-private-production
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=security@yourdomain.com
