{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VaultObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET_NAME/vaults/*"
    },
    {
      "Sid": "VaultKmsOnly",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "REPLACE_KMS_KEY_ARN"
    }
  ]
}
